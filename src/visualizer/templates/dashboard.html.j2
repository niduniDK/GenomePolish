<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PolishML — {{ site.contig }} : {{ site.position }}</title>

<!-- Plotly (pin versions; swap for local copies if the cluster has no internet) -->
<script src="https://cdn.jsdelivr.net/npm/plotly.js-dist-min@2.35.2/plotly.min.js"></script>

<link rel="stylesheet" href="dashboard.css">
</head>
<body>

<div class="dash">

  <!-- ======================= HEADER ======================= -->
  <header class="dash-header">
    <div class="brand">
      <span class="brand-mark">PML</span>
      <div>
        <div class="brand-title">PolishML</div>
        <div class="brand-sub">Comparative genome view · {{ site.zoom_bp | default(10) }}px</div>
      </div>
    </div>
    <div class="header-right">
      <span class="contig-range">contig_{{ site.contig }} : {{ "{:,}".format(site.range_start) }} – {{ "{:,}".format(site.range_end) }}</span>
      {% if site.status %}
      <span class="status-pill status-{{ site.status_level | default('warn') }}">{{ site.status }}</span>
      {% endif %}
    </div>
  </header>

  <!-- ======================= METRIC CARDS ======================= -->
  <section class="metric-row">
    <div class="metric-card">
      <div class="metric-index">1</div>
      <div id="metric-assembly-base" class="metric-value base">{{ site.assembly_base }}</div>
      <div class="metric-label">Assembly base</div>
    </div>
    <div class="metric-card">
      <div class="metric-index">2</div>
      <div id="metric-corrected-base" class="metric-value base accent-green">{{ site.corrected_base }}</div>
      <div class="metric-label">Corrected base</div>
    </div>
    <div class="metric-card">
      <div class="metric-index">3</div>
      <div id="metric-p-error" class="metric-value accent-cyan">{{ "%.3f"|format(site.p_error) }}</div>
      <div class="metric-label">p(error) calibrated</div>
    </div>
    <div class="metric-card">
      <div class="metric-index">4</div>
      <div id="metric-decision" class="metric-value accent-amber">{{ site.decision }}</div>
      <div class="metric-label">Decision (p &lt; {{ site.threshold }})</div>
    </div>
  </section>

  <!-- ======================= RAW VS POLISHED ======================= -->
  <section class="panel">
    <h2><span class="dot dot-error"></span> Raw assembly vs polished — whole genome</h2>
    <p class="alignment-help">Use the arrows to move through the contig. Each window loads {{ alignment_window_bases }} bases.</p>
    <form id="location-form" class="location-controls">
      <label>Contig<input id="contig-input" type="text" value="{{ site.contig }}" spellcheck="false"></label>
      <label>256-window #<input id="window-input" type="number" min="1" value="1" step="1"></label>
      <label>Base position<input id="base-position-input" type="number" min="1" value="{{ site.position }}" step="1"></label>
      <button type="submit">Go</button>
      <button id="zoom-in" type="button">Zoom in</button>
      <button id="zoom-out" type="button">Zoom out</button>
    </form>
    <output id="window-position" class="selected-position">Selected base: {{ site.position }}</output>
    <input id="window-row-selector" type="range" min="0" max="{{ [window_rows|length - 1, 0]|max }}" value="0" step="1" hidden>
    
    {% for contig_alignment in genome_alignment %}
    <div class="contig-alignment">
      <div class="contig-alignment-title">{{ contig_alignment.contig }} <span>{{ "{:,}".format(contig_alignment.length) }} bases</span></div>
      <div class="alignment-navigation">
        <button class="alignment-nav alignment-nav-prev" type="button" aria-label="Previous genome window" title="Previous genome window">&#x25C0;</button>
        <div class="align-view lazy-alignment" data-contig-index="{{ loop.index0 }}"></div>
        <button class="alignment-nav alignment-nav-next" type="button" aria-label="Next genome window" title="Next genome window">&#x25B6;</button>
      </div>
      <output class="alignment-position-value">1–{{ [alignment_window_bases, contig_alignment.length]|min }}</output>
    </div>
    {% endfor %}
    <div class="legend">
      <span><i class="sw sw-base-a"></i> A</span>
      <span><i class="sw sw-base-c"></i> C</span>
      <span><i class="sw sw-base-g"></i> G</span>
      <span><i class="sw sw-base-t"></i> T</span>
      <span><i class="sw sw-base-gap"></i> Gap</span>
      <span><i class="sw sw-base-unknown"></i> Unknown</span>
      <span><i class="sw sw-connection"></i> Connection: | match, x changed</span>
    </div>
    <div class="inline-pileup">
      <h3><span class="dot dot-purple"></span> <span id="read-support-title">Reads at selected base</span></h3>
      <div id="read-support-summary" class="read-support-summary"></div>
      <div id="read-support-list" class="read-support-list"></div>
    </div>
  </section>

  <!-- ======================= SHAP + RATIONALE ======================= -->
  <section class="triple-row">

    <div class="panel shap-panel">
      <h2><span class="dot dot-violet"></span> Feature contributions (SHAP)</h2>
      <label class="shap-count-control" for="shap-feature-count">Features shown</label>
      <select id="shap-feature-count" aria-label="Number of SHAP features shown">
        <option value="5">Top 5</option>
        <option value="10" selected>Top 10</option>
        <option value="15">Top 15</option>
        <option value="20">Top 20</option>
        <option value="all">All</option>
      </select>
      <div class="shap-axis-labels">
        <span>← Pushes correct</span><span>Pushes error →</span>
      </div>
      <div id="shap-chart"></div>
      <div class="shap-footer">
        Base prediction: <span id="shap-base-value">{{ shap.base_value }}</span> &nbsp;|&nbsp; SHAP sum: <span id="shap-sum">{{ shap.shap_sum }}</span>
        &nbsp;|&nbsp; Final p(error): <b id="shap-final-value">{{ shap.final_value }}</b>
      </div>
    </div>

    <div class="panel rationale-panel">
      <h2><span class="dot dot-amber"></span> Decision rationale</h2>
      <p id="rationale-summary">{{ rationale.summary }}</p>
      <p id="rationale-pileup" class="rationale-pileup">{{ rationale.pileup_argument }}</p>
    </div>

  </section>

</div>

<!-- ======================= DATA HANDOFF ======================= -->
<!-- Summary data is embedded by Jinja2. Alignment sequence windows are fetched on demand. -->
<script id="pileup-data" type="application/json">{{ pileup.reads | tojson }}</script>
<script id="shap-data" type="application/json">{{ shap.features | tojson }}</script>
<script id="window-data" type="application/json">{{ window_rows | tojson }}</script>
<script id="feature-names" type="application/json">{{ feature_names | tojson }}</script>
<script id="feature-baseline" type="application/json">{{ feature_baseline | tojson }}</script>
<script id="site-data" type="application/json">{{ site | tojson }}</script>
<script id="alignment-manifest-url" type="application/json">{{ "alignment-manifest.json" | tojson }}</script>

<script src="shap_wasm.js"></script>
<script src="dashboard.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", async function () {
    const initialShapFeatures = JSON.parse(document.getElementById("shap-data").textContent);
    const windowRows = JSON.parse(document.getElementById("window-data").textContent);
    const featureNames = JSON.parse(document.getElementById("feature-names").textContent);
    const featureBaseline = JSON.parse(document.getElementById("feature-baseline").textContent);
    const initialSite = JSON.parse(document.getElementById("site-data").textContent);
    const alignmentManifestUrl = JSON.parse(document.getElementById("alignment-manifest-url").textContent);
    let selectedSite = null;
    let zoomRadius = 25;

    document.getElementById("location-form").addEventListener("submit", (event) => {
      event.preventDefault();
      window.dispatchEvent(new CustomEvent("polishml:location-requested", {
        detail: {
          contig: document.getElementById("contig-input").value.trim(),
          window: Number(document.getElementById("window-input").value),
          position: Number(document.getElementById("base-position-input").value),
        },
      }));
    });
    document.getElementById("window-input").addEventListener("change", (event) => {
      const windowNumber = Math.max(1, Number(event.target.value) || 1);
      document.getElementById("base-position-input").value = (windowNumber - 1) * 256 + 1;
    });
    const zoomToSelectedBase = (radius) => {
      if (!selectedSite) return;
      zoomRadius = radius;
      window.dispatchEvent(new CustomEvent("polishml:alignment-focus", {
        detail: {
          contig: selectedSite.contig,
          start: Math.max(1, Number(selectedSite.position) - radius),
          end: Number(selectedSite.position) + radius,
        },
      }));
    };
    document.getElementById("zoom-in").addEventListener("click", () => {
      zoomToSelectedBase(Math.max(5, Math.floor(zoomRadius / 2)));
    });
    document.getElementById("zoom-out").addEventListener("click", () => {
      zoomToSelectedBase(Math.min(2048, zoomRadius * 2));
    });

    window.addEventListener("polishml:alignment-window-changed", (event) => {
      const { contig, start, end, window } = event.detail;
      document.getElementById("contig-input").value = contig;
      document.getElementById("window-input").value = window;
    });
    let selectedShapSite = initialSite;
    const updateKernelShap = () => PolishMLDash.renderKernelShap(
      selectedShapSite,
      "shap-chart",
      "shap-feature-count",
    ).catch(console.error);
    document.getElementById("shap-feature-count").addEventListener("change", updateKernelShap);
    void updateKernelShap();
    void PolishMLDash.renderReadSupport(initialSite);
    window.addEventListener("polishml:base-selected", (event) => {
      const site = event.detail;
      selectedSite = site;
      selectedShapSite = site;
      zoomRadius = 25;
      document.getElementById("metric-assembly-base").textContent = site.assembly_base;
      document.getElementById("metric-corrected-base").textContent = site.corrected_base;
      document.getElementById("metric-p-error").textContent = Number(site.p_error).toFixed(3);
      document.getElementById("metric-decision").textContent = site.decision;
      document.getElementById("contig-input").value = site.contig;
      document.getElementById("window-input").value = Math.floor((Number(site.position) - 1) / 256) + 1;
      document.getElementById("base-position-input").value = site.position;
      void updateKernelShap();
      PolishMLDash.renderReadSupport(site);
      zoomToSelectedBase(25);
    });
    try {
      await PolishMLDash.initializeLazyAlignments(".lazy-alignment", alignmentManifestUrl);
    } catch (error) {
      document.querySelectorAll(".lazy-alignment").forEach((container) => {
        container.textContent = `Alignment unavailable: ${error.message}. Open this dashboard over http://127.0.0.1, not https://.`;
        container.classList.add("alignment-error");
      });
      console.error(error);
    }
  });
</script>

</body>
</html>
